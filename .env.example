# The Graph
GRAPH_API_KEY=
# Base URL a BARE subgraph id is appended to. Default:
# https://gateway.thegraph.com/api/subgraphs/id
# A per-chain id below that already starts with http is used verbatim instead,
# which is how Studio deployments (account path + version) and decentralized
# gateway deployments (bare id) can be mixed in one process.
GRAPH_GATEWAY_URL=

# market-data
REDIS_URL=
POLL_INTERVAL=
# Thresholds. The bare key is the MAINNET rule; the testnet has its own defaults
# (no TVL floor, 0% APY allowed) because a venue paying nothing on Base Sepolia
# means nobody borrows there, not that it is broken. Override the testnet
# explicitly with MIN_TVL_USD_84532 / MAX_APY_84532 — the bare key never reaches it.
MIN_TVL_USD=5000
MAX_APY=
# Withdrawable (not supplied) USD a venue must hold to be routable. A market at
# 100% utilisation publishes a headline APY and cannot be exited.
MIN_LIQUIDITY_USD=1000
MIN_TVL_USD_84532=
MAX_APY_84532=
MIN_LIQUIDITY_USD_84532=0
# Chains served simultaneously, canonical labels. The frontend toggles between
# them per request; venue ids are "<label>:<project>:<pool>".
#   base         8453   Base mainnet
#   base-sepolia 84532  Base Sepolia
CHAINS=base,base-sepolia
MARKET_DATA_ADDR=

# Subgraph deployments are per protocol PER CHAIN. There is no chain-agnostic
# variable and no default: an unset one reports the adapter as unconfigured in
# GET /sources rather than quietly serving another network's venues.
# Base mainnet (decentralized gateway, bare deployment ids):
AAVE_V3_SUBGRAPH_ID_8453=GQFbb95cE6d8mV989mL5figjaGaKCQB3xqYrr1bRyXqF
COMPOUND_V3_SUBGRAPH_ID_8453=2hcXhs36pTBDVUmk5K2Zkr6N4UYGwaHuco2a6jyTsijo
MOONWELL_SUBGRAPH_ID_8453=33ex1ExmYQtwGVwri1AP3oMFPGSce6YbocBP7fWbsBrg
MORPHO_SUBGRAPH_ID_8453=
# Base Sepolia (ours, on Studio — full URL, used verbatim):
# https://api.studio.thegraph.com/query/<account>/<slug>/<version>
AAVE_V3_SUBGRAPH_ID_84532=
COMPOUND_V3_SUBGRAPH_ID_84532=
MOONWELL_SUBGRAPH_ID_84532=
MORPHO_SUBGRAPH_ID_84532=

# wallet svc
DATABASE_URL=
WALLET_ADDR=
MARKET_DATA_URL=
EXECUTOR_URL=

# privy  (fill from Privy dashboard)
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=

# keeper -> wallet service-to-service auth (empty disables the path)
KEEPER_SECRET=

# token api  (fill: thegraph.com/token-api)
TOKEN_API_JWT=

# wallet svc — routing
REBALANCE_THRESHOLD_APY=
MAX_SLIPPAGE_BPS=

# the graph token api
TOKEN_API_URL=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# rpc + price feeds
# One node per chain. No shared BASE_RPC_URL: a price or receipt read off the
# wrong network is a confident wrong answer, not a missing one. Defaults are the
# public endpoints (rate-limited, eth_getLogs capped at 10k blocks).
BASE_RPC_URL_8453=
BASE_RPC_URL_84532=
# Chain a basket lands on when the client does not name one. Canonical label.
DEFAULT_CHAIN=base
PRICE_MAX_AGE=
PRICE_CACHE_TTL=
RECEIPT_TIMEOUT=
PRIVY_KEY_QUORUM_ID=
PRIVY_POLICY_ID=
GRAPH_DEPLOY_KEY=
MIN_VENUE_TVL_USD=5000

# ---------------------------------------------------------------------------
# Infrastructure. Read by Terraform on your machine; stripped before this file
# is copied to the server, so nothing here ever reaches the instance.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
